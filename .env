# =========================================================================
# Ratnakar Securities Frontend - Environment Variables Template
# Copy this file to '.env.local' or '.env' to configure environment variables.
# =========================================================================

# App Environment Stage: 'local', 'stage' (or 'staging'), or 'production'
# Defaults to 'local' if unset.
NEXT_PUBLIC_APP_ENV=stage

# Direct URL override for API backend endpoints.
# Takes highest precedence over NEXT_PUBLIC_APP_ENV when defined.
# NEXT_PUBLIC_API_URL=http://localhost:6010/api
